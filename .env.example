# ---------------------------------------------------------------------------
# Joshi Software Solutions — environment configuration
# Copy this file to `.env.local` and fill in real values. Never commit .env.local.
# ---------------------------------------------------------------------------

# Public business contact details (safe to expose to the browser)
NEXT_PUBLIC_BUSINESS_EMAIL= example@example.com
NEXT_PUBLIC_BUSINESS_PHONE=+1234567890

# Public site URL used for metadata, sitemap, and canonical URLs.
# Replace with your actual deployed URL.
NEXT_PUBLIC_SITE_URL=https://your-free-subdomain.example

# Web3Forms access key — PUBLIC (safe to expose to the browser).
# Web3Forms' free plan submits from the client, so this key is included in the
# browser bundle by design. It is a form identifier, not a secret.
# Protect it by adding a domain restriction in the Web3Forms dashboard
# (Settings -> Allowed Domains) so it only works from your own domains.
# Get it from https://web3forms.com by creating a form with your email.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=your_web3forms_access_key_here

# Sanity CMS configuration — PUBLIC (safe to expose to the browser).
# These are used to fetch published content from Sanity CMS.
# Create a project at https://www.sanity.io/manage and get your project ID.
# The dataset name is usually "production" unless you created a custom one.
NEXT_PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id
NEXT_PUBLIC_SANITY_DATASET=production

# Sanity Studio configuration — PRIVATE (server-side only).
# These are used for Sanity Studio and write operations.
# SANITY_STUDIO_PROJECT_ID is the same as NEXT_PUBLIC_SANITY_PROJECT_ID.
# SANITY_STUDIO_DATASET is the same as NEXT_PUBLIC_SANITY_DATASET.
# SANITY_API_TOKEN is a token with write permissions for seeding/importing.
# Create one at https://www.sanity.io/manage > API > Tokens > Add API token
SANITY_STUDIO_PROJECT_ID=your_sanity_project_id
SANITY_STUDIO_DATASET=production
SANITY_API_TOKEN=your_sanity_write_token

# Optional: secret for the /api/revalidate webhook endpoint.
# If set, POST to /api/revalidate with header "x-webhook-secret: <secret>"
# (or ?secret=<secret>) to invalidate the blog cache immediately after publishing.
# Leave empty to disable the endpoint. Never expose this secret to the browser.
SANITY_REVALIDATE_SECRET=