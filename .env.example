# ---------------------------------------------------------------------------
# Joshi Software Solutions — environment configuration
# Copy this file to `.env.local` and fill in real values. Never commit .env.local.
# ---------------------------------------------------------------------------

# Public business contact details (safe to expose to the browser)
NEXT_PUBLIC_BUSINESS_EMAIL=joshisoftwaresolutions2@gmail.com
NEXT_PUBLIC_BUSINESS_PHONE=+919716222967

# Public site URL used for metadata, sitemap, and canonical URLs.
# Replace with your actual deployed URL.
NEXT_PUBLIC_SITE_URL=https://your-free-subdomain.example

# Web3Forms access key — SERVER ONLY. Do not prefix with NEXT_PUBLIC_.
# Get this from https://web3forms.com by creating a form with your email.
WEB3FORMS_ACCESS_KEY=your_web3forms_access_key_here
